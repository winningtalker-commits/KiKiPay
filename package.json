{
  "name": "kikipay",
  "version": "1.0.0",
  "type": "module",
  "description": "KiKiPay — private payroll & splits on Midnight: distribute funds without exposing amounts or recipients",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run copy-zk && vite",
    "build": "npm run copy-zk && npm run typecheck && vite build",
    "preview": "vite preview",
    "copy-zk": "node scripts/copy-zk-assets.mjs",
    "compile": "compact compile contracts/kikipay.compact contracts/managed/kikipay",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "setup": "npx tsx cli/setup.ts",
    "deploy": "npx tsx cli/deploy.ts",
    "cli": "npx tsx cli/cli.ts",
    "check-balance": "npx tsx cli/check-balance.ts",
    "network": "npx tsx cli/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "node scripts/clean.mjs",
    "embed:evidence": "node scripts/embed-test-evidence.mjs",
    "embed:check": "node scripts/embed-test-evidence.mjs --check"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@scure/bip39": "2.2.0",
    "bech32": "^2.0.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "privacy",
    "payroll"
  ],
  "allowScripts": {
    "classic-level@3.0.0": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true
  }
}
