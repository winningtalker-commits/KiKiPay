# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract artifacts (regenerate with: npm run compile)
# NOTE: the challenge wants managed/ to exist after compiling — it is produced
# by `npm run compile` and intentionally not committed (56 MB of prover keys).
contracts/managed/

# Deployment info
deployment.json

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/

# Wallet private-state LevelDB store (created at runtime by midnight-js)
midnight-level-db/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses) — CONTAINS SECRETS
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/
.freebuff/
